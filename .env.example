# Environment Configuration — Spare Parts Demand Forecasting & Firm Scheduling
#
# Copy this file to .env and fill in the values.
# Do not commit .env to Git.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DB_NAME=backend.sqlite3

# Optional: server database (MySQL or PostgreSQL)
# DB_ENGINE=mysql
# DB_NAME=spares_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
